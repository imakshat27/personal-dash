# Copy to .dev.vars.local for a local Google connection. Never commit actual secrets.
# Register http://localhost:5173/api/integrations/drive/callback with Google.
GOOGLE_CLIENT_ID=your-client.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Generate using: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_ENCRYPTION_KEY=replace-with-a-generated-32-byte-base64url-key
# OWNER_EMAIL is already configured in wrangler.jsonc. No Cloudflare Access secrets needed.

# Optional, read-only zone analytics (see docs/cloudflare-analytics.md)
# CLOUDFLARE_API_TOKEN=your-read-only-token
