{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-dash",
  "account_id": "ee86951ee9b792b8e8e816ef34b34591",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "orbit.imakshat.com",
      "custom_domain": true,
    },
  ],
  "vars": {
    "APP_MODE": "live",
    "OWNER_EMAIL": "agarwalakshat2710@gmail.com",
    "CLOUDFLARE_ACCOUNT_ID": "ee86951ee9b792b8e8e816ef34b34591",
    "STORAGE_PROVIDER": "drive",
    "APP_ORIGIN": "https://orbit.imakshat.com",
  },
  // Google Drive uses OAuth server secrets; R2 is not required for production.
  "env": {
    "local": {
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "orbit-db",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "orbit-files",
        },
      ],
      "vars": {
        "APP_MODE": "live",
        "OWNER_EMAIL": "agarwalakshat2710@gmail.com",
        "CLOUDFLARE_ACCOUNT_ID": "ee86951ee9b792b8e8e816ef34b34591",
        "LOCAL_DEV": "true",
        "STORAGE_PROVIDER": "r2",
        "APP_ORIGIN": "http://localhost:5173",
      },
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orbit-db",
      "database_id": "1f4562f9-d3b4-4190-bae5-b5a59b72232a",
      "migrations_dir": "migrations",
      "remote": true,
    },
  ],
}
