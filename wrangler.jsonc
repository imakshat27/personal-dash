{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-dash",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": { "APP_MODE": "live" },
  // Before deployment, add D1 and R2 bindings as described in README.md.
  "env": { "local": { "vars": { "APP_MODE": "demo", "LOCAL_DEV": "true" } } },
}
